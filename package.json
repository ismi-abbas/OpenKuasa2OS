{
  "name": "openkuasa-os",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:web": "pnpm --filter @openkuasa/web dev",
    "dev:api": "pnpm --filter @openkuasa/api dev",
    "build": "pnpm --filter @openkuasa/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @openkuasa/api db:generate",
    "db:migrate": "pnpm --filter @openkuasa/api db:migrate",
    "deploy": "pnpm build && pnpm --filter @openkuasa/api deploy"
  },
  "packageManager": "pnpm@11.10.0"
}
